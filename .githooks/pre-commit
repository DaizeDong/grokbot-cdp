#!/bin/sh
# Fifteen lines that must live IN THIS REPO, because they are what runs when the submodule does not.
#
# THE HOLE THIS CLOSES. Pointing core.hooksPath straight at guards/hooks looks like the tidy
# arrangement, and it is a fail-open. A plain `git clone` without --recursive leaves guards/ present
# and EMPTY. git then finds no hook file at that path and runs NOTHING, exit 0, no message. Worse,
# a repo-level setting SHADOWS whatever wider hook configuration would otherwise apply, so the one
# gate that would still have been there is switched off by the same line. Measured 2026-09-02 on a
# fresh clone with a synthetic probe: without the repo-level setting the commit was refused with
# exit 1; with it pointing at the empty directory the identical commit went in, exit 0, in silence.
#
# So the delegating stub is tracked and the substance is pinned. An absent kit is a BLOCK with a
# sentence, never a quiet pass. Keep this file boring: every line here is a line the submodule
# cannot deduplicate.
set -e
_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
_REAL="$_ROOT/guards/hooks/pre-commit"
if [ ! -x "$_REAL" ] && [ ! -f "$_REAL" ]; then
  echo "BLOCKED: guards/hooks/pre-commit is missing, so nothing checked this commit."
  echo "  The guards submodule is not checked out. Fix it, do not bypass it:"
  echo "      git submodule update --init --recursive"
  echo "  An empty guards/ is an UNGUARDED repo, not a repo with nothing to check, and this"
  echo "  setting also shadows any wider hook configuration, so skipping here skips everything."
  exit 1
fi
# A repo that also uses the pre-commit FRAMEWORK chains it here. `pre-commit install` refuses
# to run while core.hooksPath is set, and the hint it prints is to unset it, which would
# switch the guards off; a reader following that hint gets a working formatter and no gate.
# Calling `pre-commit run` from this stub keeps both, and keeps the guard LAST so a
# formatter that rewrites files cannot slip a change past the scan. Absent config or absent
# binary means the block is skipped, which is correct: nothing was asked for.
if [ -f "$_ROOT/.pre-commit-config.yaml" ] && command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage pre-commit || exit 1
fi

# The one check the submodule cannot deduplicate, because this is the only repo in the
# fleet whose real-run output is a PICTURE. data_boundary's run-shape check knows jsonl
# ledgers, dated files under output directories and databases; a bare .jpg is not a shape
# it recognises, and `git add -f screen.jpg` followed by the guard prints "clean" and
# exits 0. Measured on a scratch copy, so this is not a worry about what might happen.
#
# tests/test_repo_hygiene.py does catch it, and runs only in CI, which is one step after
# the frame is public. For a screenshot of a live machine that is one step too late, so
# the same question is asked here, in shell, with no dependency that can be absent: an
# optional framework that is skipped when its binary is missing is the wrong shape for a
# control whose whole job is to be there.
_IMGS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -iE '\.(jpg|jpeg|png|gif|bmp|webp|tiff?|avif)$' || true)
if [ -n "$_IMGS" ]; then
  echo "BLOCKED: this commit adds an image, and the only images this repo can produce are"
  echo "frames of a live remote machine, which show whatever was on it:"
  echo "$_IMGS" | sed 's/^/      /'
  echo "  If it is genuinely not a captured screen, say so in the commit and re-run with the"
  echo "  file removed from the index, then add it in a commit of its own that says what it is."
  exit 1
fi

exec sh "$_REAL" "$@"

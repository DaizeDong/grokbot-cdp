#!/bin/sh
# Privacy checks run from the local fleet-guards checkout named by git config fleet.guards.
G=$(git config --get fleet.guards)
if [ -z "$G" ] || [ ! -s "$G/hooks/pre-commit" ]; then
  echo "BLOCKED: git config fleet.guards is unset or has no hooks/pre-commit; nothing was checked." >&2
  exit 1
fi
S=$(git config --get fleet.style)
if [ -z "$S" ] || [ ! -s "$S/tools/dash_guard.py" ]; then
  echo "BLOCKED: git config fleet.style is unset or has no tools/dash_guard.py; nothing was checked." >&2
  exit 1
fi
python "$S/tools/dash_guard.py" --staged --added-only </dev/null || exit 1
# The only real-run output this repo can produce is a screenshot of a live machine, and
# data_boundary does not recognise an image as a real-run shape, so staged images are refused here.
_IMGS=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.(jpg|jpeg|png|gif|bmp|webp|tiff?|avif)$' || true)
if [ -n "$_IMGS" ]; then
  echo "BLOCKED: this commit adds an image; images here are frames of a live remote machine:" >&2
  echo "$_IMGS" | sed 's/^/      /' >&2
  exit 1
fi
exec sh "$G/hooks/pre-commit" "$@"
